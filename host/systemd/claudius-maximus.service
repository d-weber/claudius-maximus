# Claudius Maximus companion daemon (Linux). Generated by tools/install.sh from host/systemd/ (template
# placeholders: python, repo root, log file) into ~/.config/systemd/user/claudius-maximus.service.
[Unit]
Description=Claudius Maximus desk companion daemon
After=default.target

[Service]
Type=simple
WorkingDirectory=@ROOT@/host
ExecStart=@PYTHON@ -m companion run --log @LOG@
Restart=always
RestartSec=10
Nice=5
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=default.target
