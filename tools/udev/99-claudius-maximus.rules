# Claudius Maximus (Linux, optional): keep ModemManager off the ESP32-S3's USB serial port, and make it
# accessible without being in the dialout group.   sudo cp tools/udev/99-claudius-maximus.rules /etc/udev/rules.d/
#                                                     sudo udevadm control --reload && sudo udevadm trigger
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ENV{ID_MM_DEVICE_IGNORE}="1", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="303a", ENV{ID_MM_DEVICE_IGNORE}="1"
