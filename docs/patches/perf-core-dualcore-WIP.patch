+    const lv_area_t *a = &flush_area;
+    gfx->draw16bitRGBBitmap(a->x1, a->y1, (uint16_t *)&flush_px->full, a->x2 - a->x1 + 1, a->y2 - a->y1 + 1);
+    perf_add(PERF_FLUSH, perf_now_us() - t0);
+    lv_disp_flush_ready(&disp_drv);
+  }
+}
